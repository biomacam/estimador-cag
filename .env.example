# LLM Provider configuration
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Application
APP_ENV=development
LOG_LEVEL=DEBUG

# --- Session 3 — LiteLLM wrapper ----------------------------------------------
# The wrapper tries PRIMARY_MODEL first and falls back to FALLBACK_MODEL on
# failure, with up to LLM_RETRIES attempts and an LLM_TIMEOUT-second deadline.
PRIMARY_MODEL=gpt-4o-mini
FALLBACK_MODEL=claude-haiku-4-5-20251001
LLM_TIMEOUT=30
LLM_RETRIES=2

# --- Session 3 � Redis exact-match cache --------------------------------------
# Inside docker-compose, REDIS_URL is overridden to redis://redis:6379.
# When running uvicorn locally (outside Docker), use redis://localhost:6379.
REDIS_URL=redis://localhost:6379
CACHE_TTL=86400

# --- Session 3 � Streamlit transport ------------------------------------------
# Streamlit hits the FastAPI service over HTTP. Point this to wherever the
# estimator is reachable from the machine running streamlit_app.py.
ESTIMATOR_API_BASE_URL=http://localhost:8000

# --- Sessions and attachments ---------------------------------------------------
# user+assistant pairs kept in each session's history window.
MAX_CONVERSATION_TURNS=6
# Cut per extracted attachment (characters). Longer files are truncated, not rejected.
MAX_ATTACHMENT_CHARS=60000
# Model of the second per-turn call that extracts the project metadata.
METADATA_EXTRACTOR_MODEL=gpt-4o-mini

# --- Ingestion — Postgres + catalog + PII ---------------------------------------
# Inside docker-compose, DATABASE_URL is overridden to estimator-postgres:5432.
# When running uvicorn locally (outside Docker), use localhost:5433 (host-mapped).
DATABASE_URL=postgresql+psycopg://estimator:estimator@localhost:5433/estimator

# Data-source catalog (YAML), validated at startup. ``include`` decisions drive ingestion.
CATALOG_PATH=data/catalog/catalog.yaml

# Root folder the catalog ``location`` entries are resolved against.
INGESTION_DATA_ROOT=data/seed

# Spanish spaCy model for Presidio; the default English one silently misses Hispanic names.
PRESIDIO_SPACY_MODEL=es_core_news_md
PSEUDONYM_FAKER_LOCALE=es_ES

# HMAC salt for pseudonym_mappings.original_hash. Rotating it invalidates all prior
# mappings. Startup fails in production while this keeps the default value.
PSEUDONYM_HASH_SALT=change-me-in-prod

# --- RAG estimation (transcript -> grounded estimate) ---------------------------
# Independent keys (header X-API-Key) for /v1/retrieval/* and /v1/estimate/*.
# Blank disables the router (401 on every request).
RETRIEVAL_API_KEY=
ESTIMATE_API_KEY=
# Reformulation distills the transcript; generation grounds the estimate in the retrieved budgets.
REFORMULATION_MODEL=gpt-5-mini
GENERATION_MODEL=gpt-5
GENERATION_REASONING_EFFORT=high
# Reasoning tokens count against this cap; too low truncates the JSON.
GENERATION_MAX_TOKENS=64000
RETRIEVAL_TOP_K=10
RETRIEVAL_DISTANCE_THRESHOLD=0.6
MAX_CONTEXT_TOKENS=16384
IDEMPOTENCY_TTL=86400

# --- Hybrid search + cross-encoder reranking ------------------------------------
# vector | hybrid (dense + full-text fused with RRF). Also switchable at runtime
# via PUT /api/v1/config/retrieval. Hybrid needs migration 0006 (alembic upgrade head).
RETRIEVAL_SEARCH_MODE=vector
RERANKER_ENABLED=true
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RETRIEVAL_RECALL_TOP_K=50
RERANK_TOP_N=5
RRF_K=60
