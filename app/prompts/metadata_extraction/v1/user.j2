<previous_metadata>
{% if previous %}
- project_name: {{ previous.project_name }}
- assumed_team_size: {{ previous.assumed_team_size }}
- mentioned_technologies: {{ previous.mentioned_technologies }}
- agreed_scope: {{ previous.agreed_scope }}
{% else %}
(empty: this is the first turn)
{% endif %}
</previous_metadata>

<latest_user_transcript>
{{ framed_transcript }}
</latest_user_transcript>

<latest_assistant_estimation>
summary: {{ result.summary }}
total_duration_weeks: {{ result.total_duration_weeks }}
total_cost_eur: {{ result.total_cost_eur }}
confidence_pct: {{ result.confidence_pct }}
phases:
{% for phase in result.phases %}
- {{ phase.name }} ({{ phase.duration_weeks }}w, {{ phase.cost_eur }} EUR): {{ phase.summary }}
{% endfor %}
</latest_assistant_estimation>

